# секреты — никогда в репозиторий
.env
.env.*
.env.bak.*
!.env.example
deploy/.env
*.pem
*.key

# зависимости и сборка
node_modules/
dist/
build/
.vite/

# данные и загрузки
# Ведущая косая черта обязательна: без неё «data/» прячет ЛЮБУЮ папку с
# таким именем на любой глубине — в том числе backend/src/modules/data,
# и целый модуль тихо не попадает в репозиторий.
uploads/
/data/
postgres-data/
minio-data/
certbot/
acme/
deploy/acme/

# служебное
.DS_Store
Thumbs.db
*.log
.idea/
.vscode/

# сборка андроид-приложения
# Ключ подписи в репозитории — это возможность подписать поддельное
# обновление. Держим его только на сервере и в отдельной копии.
deploy/android/android.keystore
deploy/android/*.apk
deploy/android/app/
deploy/android/.gradle/
deploy/android/build/
deploy/android/gradle*
deploy/android/*.gradle
deploy/android/store_icon.png
deploy/android/manifest-checksum.txt
# APK для скачивания собирается на сервере, в git ему делать нечего
frontend/public/app/

# Сюда складывается то, что не удалось удалить из песочницы.
# Содержимое можно смело стирать вручную.
_to_delete/
