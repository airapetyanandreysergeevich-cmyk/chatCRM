server {
    listen 80;
    server_name ${SERVER_NAMES};
    client_max_body_size 60m;

    location /.well-known/acme-challenge/ { root /var/www/certbot; }

    # Установщик для Windows и всё, что раздаётся файлом.
    #
    # Отдельной папкой на диске, а не внутри образа фронтенда: установщик
    # весит около 400 МБ, и, попади он в сборку, каждая пересборка тащила бы
    # эти мегабайты в контекст, в слои и в репозиторий. Здесь же он просто
    # лежит, обновляется копированием и переживает любые пересборки.
    #
    # Отдельный location ещё и потому, что иначе отсутствующий файл вернул бы
    # страницу сайта под именем .exe — ровно та поломка, что уже была с APK.
    location /download/ {
        alias /srv/downloads/;
        autoindex off;
        add_header Cache-Control "public, max-age=3600";
    }

    location /api/ {
        proxy_pass http://backend:4000;
        # Загрузка базы из файла идёт одной транзакцией и на нескольких
        # тысячах строк не укладывается в минуту, которую nginx ждёт по
        # умолчанию. Обрыв здесь — худший вид отказа: запись на сервере
        # продолжается, а человек видит ошибку и не знает, повторять ли.
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        proxy_pass http://frontend:80;
        proxy_set_header Host $host;
    }
}
