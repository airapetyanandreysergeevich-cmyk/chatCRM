# Скопируйте в deploy/.env и заполните. install.sh делает это сам и генерирует секреты.
# ЭТОТ ФАЙЛ — ПРИМЕР. Настоящий .env в git не попадает (см. .gitignore).

# --- база ---
POSTGRES_USER=repairshop
POSTGRES_PASSWORD=
POSTGRES_DB=repairshop

# Роль, под которой работает приложение. Отдельная от POSTGRES_USER намеренно:
# суперпользователь игнорирует RLS, и изоляция мастерских перестаёт действовать.
APP_DB_USER=repairshop_app
APP_DB_PASSWORD=

# --- домен и HTTPS (заполняет setup-https.sh) ---
DOMAIN=
DOMAIN_ALIASES=
HTTPS_ENABLED=0

# Токен API DNS-провайдера — нужен только при выпуске сертификата через DNS-проверку
# (deploy/setup-https-dns.sh). Обычная HTTP-проверка его не требует.
TIMEWEB_API_TOKEN=

# --- аутентификация ---
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
CORS_ORIGIN=*

# --- хранилище файлов (MinIO) ---
MINIO_ROOT_USER=repairshop
MINIO_ROOT_PASSWORD=
S3_BUCKET=repairshop
MAX_FILE_SIZE_MB=50

# --- push-уведомления ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# --- первый вход собственника платформы (создаётся один раз при старте) ---
PLATFORM_OWNER_EMAIL=
PLATFORM_OWNER_PASSWORD=
