// RepairShop — облачная CRM для мастерских по ремонту техники.
// Многоарендность: одна база, tenantId в каждой таблице арендатора + RLS в PostgreSQL.
// Черновик v0.1 — обсуждаем и правим до первой миграции.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
//  ПЛАТФОРМА — вне арендаторов, RLS не применяется
// ============================================================

enum PlatformRole {
  OWNER // собственник: все права, включая управление администраторами и тарифами
  ADMIN // администратор: всё, кроме создания администраторов и биллинга
}

enum TenantStatus {
  ACTIVE
  READONLY // подписка не оплачена: данные видны, изменения запрещены
  SUSPENDED
}

model PlatformUser {
  id           String       @id @default(uuid())
  email        String       @unique
  passwordHash String
  fullName     String
  role         PlatformRole @default(ADMIN)
  isActive     Boolean      @default(true)
  totpSecret   String?
  lastLoginAt  DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  impersonations Impersonation[]
  auditLogs      PlatformAuditLog[]
  sessions       Session[]
  reviewedApplications TenantApplication[]
  pushSubscriptions    PushSubscription[]
}

model Tenant {
  id       String       @id @default(uuid())
  name     String
  slug     String       @unique // короткий код мастерской, часть логина сотрудника
  status   TenantStatus @default(ACTIVE)
  plan     String       @default("trial")
  timezone String       @default("Europe/Moscow")

  maxUsers    Int    @default(10)
  maxStorageMb Int   @default(5000)

  // нумерация заказов — своя у каждой мастерской
  orderNumberPrefix String @default("Р")
  orderNumberNext   Int    @default(1)
  /// Свой формат номера — образец, как его ввёл владелец: SC01, З-001, 1000.
  /// Пусто — стандартный Р-2026-00001. Приставка своего формата лежит в
  /// orderNumberPrefix, ширина и начало счётчика — рядом. Менять можно только
  /// пока в мастерской нет ни одного заказа (см. lib/orderNumber.ts).
  orderNumberTemplate String?
  orderNumberWidth    Int     @default(5)
  orderNumberStart    Int     @default(1)
  /// Год в своём формате (SC-2026-01). С ним счётчик каждый год начинается заново.
  orderNumberWithYear Boolean @default(false)
  /// К какому году относится счётчик своего формата с годом.
  orderNumberYear     Int?

  /// Счётчик номеров клиентов — своя нумерация у каждой мастерской, как и у заказов.
  customerNumberNext Int @default(1)

  contactName  String?
  contactPhone String?
  contactEmail String?
  settings     Json    @default("{}")

  /// Распознавание шильдиков камерой на бланке приёма. Включает и выключает
  /// собственник платформы: распознаватель — общий ресурс сервера.
  plateOcr Boolean @default(true)

  /// Категория клиента платформы: цена и условия (см. ClientCategory).
  categoryId String?
  /// Своя цена в месяц, ₽. Пусто — цена категории.
  price      Int?
  /// Лимиты (сотрудники, хранилище, шильдики) выставлены вручную и не
  /// меняются вместе с категорией.
  customLimits Boolean @default(false)
  /// До какого дня оплачено облако. Пусто — срок не задан.
  paidUntil  DateTime?
  /// Когда в мастерской последний раз кто-то работал — для «в сети»
  /// у собственника. Пишется не чаще раза в минуту.
  lastSeenAt DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  category ClientCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  payments ClientPayment[]

  branches            Branch[]
  roles               Role[]
  users               User[]
  customers           Customer[]
  devices             Device[]
  orderStatuses       OrderStatus[]
  services            Service[]
  deviceHints         DeviceHint[]
  quickPicks          QuickPick[]
  orders              Order[]
  orderStatusHistory  OrderStatusHistory[]
  orderWorks          OrderWork[]
  orderParts          OrderPart[]
  orderMessages       OrderMessage[]
  attachments         Attachment[]
  purchaseRequests    PurchaseRequest[]
  purchaseItems       PurchaseRequestItem[]
  warehouses          Warehouse[]
  stockItems          StockItem[]
  stockBalances       StockBalance[]
  stockMovements      StockMovement[]
  cashRegisters       CashRegister[]
  txCategories        TransactionCategory[]
  transactions        Transaction[]
  auditLogs           AuditLog[]
  notifications       Notification[]
  pushSubscriptions   PushSubscription[]
  impersonations      Impersonation[]
  feedback            Feedback[]
  salaryEntries       SalaryEntry[]
  salaryPayouts       SalaryPayout[]
  salaryMonths        SalaryMonth[]
  printStations       PrintStation[]
  printJobs           PrintJob[]
  integrations        Integration[]
  smsMessages         SmsMessage[]
  smsApprovals        SmsApproval[]
  smsPhones           SmsPhone[]
  sessions            Session[]
  application         TenantApplication[]
}

/// Вход собственника или администратора платформы в базу арендатора.
/// Пишется всегда, виден владельцу мастерской в его кабинете.
model Impersonation {
  id             String    @id @default(uuid())
  platformUserId String
  tenantId       String
  reason         String?
  ip             String?
  startedAt      DateTime  @default(now())
  endedAt        DateTime?

  platformUser PlatformUser @relation(fields: [platformUserId], references: [id])
  tenant       Tenant       @relation(fields: [tenantId], references: [id])

  @@index([tenantId, startedAt])
}

/// Настройки платформы, общие для всех мастерских: ключ — значение.
/// Сейчас здесь один ключ — plateDictionary, словарь распознавания шильдиков.
/**
 * Коробочная мастерская, которой открыт доступ из интернета.
 *
 * Живёт в облаке, к арендаторам отношения не имеет: у коробочной версии своя
 * база на компьютере мастерской, а здесь хранится только право подключиться —
 * код в адресе и отпечаток ключа. Ключ целиком есть лишь у мастерской: мы
 * показываем его один раз при выдаче, дальше — только четыре последних знака,
 * чтобы владелец мог сверить, тот ли ключ он вставил.
 */
model Box {
  id   String @id @default(uuid())
  /// Код в адресе: https://www.finecrm.ru/b/<code>. Случайный и ни о чём не говорит.
  code String @unique

  /// Имя мастерской, которое выбрал её владелец: lenina. Логины её сотрудников
  /// — nikita@lenina; по части после @ облако понимает, в какую Основу вести
  /// вход. Пусто — имя ещё не выбрано, и войти с общего сайта нельзя.
  name String? @unique

  /// Прежнее имя после смены — держится за мастерской месяц: никому не
  /// отдаётся, а тот, кто входит по старой привычке, получает подсказку.
  previousName      String?
  previousNameUntil DateTime?

  /// Почта того, кто запросил доступ. Она же имя мастерской в списке: по ней
  /// доступ и выдан, на неё же по просьбе высылается фраза подключения.
  email String

  /// Отпечаток ключа. Самого ключа у нас нет — как и пароля сотрудника.
  keyHash String
  /// Последние знаки ключа: по ним владелец узнаёт свой, не показывая его целиком.
  keyHint String

  note     String?
  isActive Boolean @default(true)

  /// Когда Основа последний раз выходила на связь или отключалась.
  lastSeenAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  /// Категория клиента, своя цена и срок оплаты — как у облачной мастерской.
  categoryId String?
  price      Int?
  paidUntil  DateTime?

  category    ClientCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  payments    ClientPayment[]
  plateModels PlateBoxModel[]

  @@index([keyHash])
  @@index([email])
  @@index([previousName])
}

/**
 * Категория клиентов платформы: «Свои ребята», «Обычные», «Партнёры».
 *
 * Условия категории — цена, пробный срок, лимиты — получают все её клиенты.
 * Цену можно поправить отдельному клиенту (Tenant.price, Box.price), лимиты —
 * тоже (Tenant.customLimits): тогда смена условий категории его не трогает.
 */
model ClientCategory {
  id    String  @id @default(uuid())
  name  String  @unique
  /// Цвет метки: ключ палитры, как у цветов клиентов мастерской.
  color String  @default("blue")
  note  String?

  /// Облачная мастерская, ₽ в месяц. 0 — бесплатно.
  cloudPrice  Int @default(0)
  /// Доступ из интернета к локальной мастерской, ₽ в месяц.
  remotePrice Int @default(0)
  /// Сколько дней новый клиент работает до первой оплаты.
  trialDays   Int @default(14)

  maxUsers     Int     @default(10)
  maxStorageMb Int     @default(5000)
  plateOcr     Boolean @default(true)
  /// Показывать рекламу в бесплатной локальной версии. Пока ни на что не
  /// влияет — заготовка под рекламу.
  showAds      Boolean @default(true)

  /// Сюда попадают новые клиенты. Такая категория одна.
  isDefault Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenants Tenant[]
  boxes   Box[]
}

/// Оплата клиента платформы, отмеченная собственником вручную.
model ClientPayment {
  id        String   @id @default(uuid())
  tenantId  String?
  boxId     String?
  /// Имя клиента на момент оплаты: строка остаётся в истории и после удаления.
  clientName String
  amount    Int
  months    Int?
  /// До какого дня оплачено после этой оплаты.
  paidUntil DateTime
  /// Что было до неё — чтобы ошибочную оплату можно было убрать без следа.
  prevPaidUntil DateTime?
  note      String?
  createdById String?
  createdAt DateTime @default(now())

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  box    Box?    @relation(fields: [boxId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([tenantId])
  @@index([boxId])
}

/// Расход ресурсов облака клиентом за месяц.
model UsageMonth {
  /// "t:<id мастерской>" или "b:<id Основы>".
  subject       String
  /// "2026-10"
  month         String
  plateOcr      Int    @default(0)
  relayBytes    BigInt @default(0)
  relayRequests Int    @default(0)

  @@id([subject, month])
}

model PlatformSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

/// Какие марки у каких моделей вписаны в заказах коробочной Основы.
/// Облако учится на всех мастерских: свои видит в базе, а Основы присылают
/// сюда только пары «модель → марка» — ни клиентов, ни заказов.
/// Каждая Основа при отправке заменяет свои строки целиком.
model PlateBoxModel {
  boxId     String
  /// Модель без пробелов и знаков, заглавными: X515EABQ1234.
  modelKey  String
  brand     String
  /// Как модель написана — для списка у собственника.
  model     String
  /// Сколько такой техники в Основе.
  uses      Int
  updatedAt DateTime @updatedAt

  box Box @relation(fields: [boxId], references: [id], onDelete: Cascade)

  @@id([boxId, modelKey, brand])
  @@index([modelKey])
}

/// Модели, у которых марку при распознавании шильдика определить не удалось.
/// По этому списку собственник видит, каких правил не хватает словарю.
model PlateMiss {
  /// Откуда: "cloud" — мастерские облака, "local" — эта же Основа, иначе id Основы.
  source   String
  modelKey String
  model    String
  uses     Int      @default(1)
  lastAt   DateTime @default(now())

  @@id([source, modelKey])
  @@index([lastAt])
}

model PlatformAuditLog {
  id             String   @id @default(uuid())
  platformUserId String?
  tenantId       String?
  action         String
  meta           Json?
  ip             String?
  createdAt      DateTime @default(now())

  platformUser PlatformUser? @relation(fields: [platformUserId], references: [id])

  @@index([createdAt])
}

/// Refresh-сессии и для сотрудников арендаторов, и для платформенных пользователей.
model Session {
  id             String    @id @default(uuid())
  tenantId       String?
  userId         String?
  platformUserId String?
  refreshHash    String    @unique
  expiresAt      DateTime
  revokedAt      DateTime?
  ip             String?
  userAgent      String?
  createdAt      DateTime  @default(now())

  tenant       Tenant?       @relation(fields: [tenantId], references: [id])
  user         User?         @relation(fields: [userId], references: [id])
  platformUser PlatformUser? @relation(fields: [platformUserId], references: [id])

  @@index([userId])
  @@index([platformUserId])
}

enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

/// Заявка на подключение мастерской.
/// Пока она не одобрена, мастерской не существует: ни базы, ни ролей, ни статусов.
/// Отклонённая заявка не оставляет за собой ничего, кроме этой строки.
model TenantApplication {
  id            String            @id @default(uuid())
  workshopName  String
  ownerFullName String
  ownerEmail    String
  ownerPhone    String
  /// Пароль задаёт сам заявитель ещё до одобрения — храним только хеш.
  passwordHash  String
  city          String?
  comment       String?
  status        ApplicationStatus @default(PENDING)

  ip        String?
  userAgent String?

  reviewedById    String?
  reviewedAt      DateTime?
  rejectionReason String?
  /// Мастерская, созданная по этой заявке.
  tenantId        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reviewedBy PlatformUser? @relation(fields: [reviewedById], references: [id])
  tenant     Tenant?       @relation(fields: [tenantId], references: [id])

  @@index([status, createdAt])
  @@index([ownerEmail])
}

// ============================================================
//  АРЕНДАТОР — всё ниже под RLS по tenantId
// ============================================================

model Branch {
  id        String   @id @default(uuid())
  tenantId  String
  name      String
  address   String?
  phone     String?
  isDefault Boolean  @default(false)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  tenant        Tenant         @relation(fields: [tenantId], references: [id])
  users         User[]
  orders        Order[]
  warehouses    Warehouse[]
  cashRegisters CashRegister[]

  @@index([tenantId])
}

/// Роль = именованный набор прав. Пять системных пресетов создаются вместе с мастерской,
/// владелец может склонировать пресет и подправить набор под себя.
model Role {
  id          String   @id @default(uuid())
  tenantId    String
  name        String
  code        String? // MANAGER | RECEPTIONIST | MASTER | ACCOUNTANT | COURIER — у системных
  isSystem    Boolean  @default(false)
  permissions String[]
  createdAt   DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])
  users  User[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

model User {
  id       String @id @default(uuid())
  tenantId String

  /// Вход единый для всех, поэтому email уникален по всей платформе, а не внутри мастерской.
  /// Если у сотрудника нет почты, владелец заводит адрес вида master1@proba.local —
  /// он служит только идентификатором для входа.
  email        String @unique
  /// Настоящая почта для связи. Появилась вместе с логинами вида
  /// nikita@lenina: если раньше логином была почта, при переименовании она
  /// переезжает сюда, а не пропадает.
  contactEmail  String?
  /// Логин до переименования: по нему человеку подсказывают новый — только
  /// если пароль подошёл, иначе форма входа раздавала бы логины.
  previousLogin String?
  passwordHash String
  fullName     String
  phone        String?
  roleId       String?
  /// Дополнительные роли: «приёмщик» и «курьер» в одном лице. Права
  /// складываются. Основная роль — roleId, она же первая в списке.
  extraRoleIds String[] @default([])
  branchId     String?
  isOwner      Boolean @default(false) // владелец мастерской: все права, не удаляется
  isActive     Boolean @default(true)

  // для мастеров — расчёт зарплаты
  workPercent Decimal? @db.Decimal(5, 2)
  partPercent Decimal? @db.Decimal(5, 2)
  salaryBase  Decimal? @db.Decimal(12, 2)

  lastLoginAt DateTime?
  /// Когда браузер сотрудника последний раз подтвердил, что андроид-приложение
  /// установлено. Пусто — значит его нет или человек работает не с Android.
  /// Нужно владельцу: мастер без приложения не получает оповещений о заказах.
  androidAppAt DateTime?
  /// Настройки главного экрана этого сотрудника: какие панели, в каком
  /// порядке, сортировка, фильтр техники (modules/summary/prefs.ts).
  /// Пусто — всё по умолчанию.
  dashboardPrefs Json?
  /// Свой принтер сотрудника и «печатать после приёма» (см. modules/printing).
  printPrefs     Json?
  /// Агенты сотрудника: какие магазины выключены в поиске запчастей
  /// (modules/parts). Храним выключенное — новый магазин включится сам.
  agentPrefs     Json?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  tenant Tenant  @relation(fields: [tenantId], references: [id])
  role   Role?   @relation(fields: [roleId], references: [id])
  branch Branch? @relation(fields: [branchId], references: [id])

  sessions          Session[]
  acceptedOrders    Order[]              @relation("OrderAcceptedBy")
  assignedOrders    Order[]              @relation("OrderAssignedMaster")
  issuedOrders      Order[]              @relation("OrderIssuedBy")
  createdCustomers  Customer[]
  statusChanges     OrderStatusHistory[]
  works             OrderWork[]
  orderMessages     OrderMessage[]
  attachments       Attachment[]
  purchaseCreated   PurchaseRequest[]    @relation("PurchaseCreatedBy")
  purchaseApproved  PurchaseRequest[]    @relation("PurchaseApprovedBy")
  stockMovements    StockMovement[]
  transactions      Transaction[]
  auditLogs         AuditLog[]
  notifications     Notification[]
  pushSubscriptions PushSubscription[]
  feedback          Feedback[]
  salaryEntries     SalaryEntry[]        @relation("SalaryEntryUser")
  salaryEntriesMade SalaryEntry[]        @relation("SalaryEntryAuthor")
  salaryPayouts     SalaryPayout[]       @relation("SalaryPayoutUser")
  salaryPayoutsMade SalaryPayout[]       @relation("SalaryPayoutAuthor")

  @@index([tenantId])
}

/// О чём обращение. Не «категория» ради порядка, а разные вещи по сути:
/// баг чинят, пожелание обдумывают, замечание читают.
enum FeedbackKind {
  REMARK /// замечание
  WISH /// пожелание
  BUG /// баг
}

/// Обращение владельца мастерской к владельцу платформы.
///
/// Единственная таблица мастерской, которую читает не мастерская: владелец
/// платформы видит обращения всех сразу. Изоляция при этом обычная — та же,
/// что у заказов: мастерская пишет только своё и видит только своё, а
/// платформа читает всё через withPlatform. Заводить ради этого таблицу вне
/// изоляции было бы ошибкой: у обращения есть автор и мастерская, и они
/// обязаны жить по общим правилам.
model Feedback {
  id       String       @id @default(uuid())
  tenantId String
  authorId String?
  kind     FeedbackKind
  text     String

  /// Когда владелец платформы пометил обращение разобранным. Пусто — новое.
  handledAt DateTime?
  createdAt DateTime  @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])
  author User?  @relation(fields: [authorId], references: [id])

  @@index([tenantId, createdAt])
  @@index([handledAt, createdAt])
}

enum CustomerType {
  INDIVIDUAL
  COMPANY
}

model Customer {
  id       String @id @default(uuid())
  tenantId String

  /// Короткий номер клиента внутри мастерской.
  ///
  /// Нужен там, где телефон не годится в опознавательный знак: при переносе
  /// из другой программы половина карточек приезжает с выдуманным номером или
  /// вовсе без него, а повторная загрузка того же файла не должна задваивать
  /// людей. Заодно им удобно продиктовать клиента по телефону — «номер 412»
  /// короче одиннадцати цифр.
  number Int
  type            CustomerType @default(INDIVIDUAL)
  name            String
  phone           String
  phone2          String?
  email           String?
  address         String?
  source          String? // источник обращения
  inn             String? // для юрлиц
  discountPercent Decimal      @default(0) @db.Decimal(5, 2)
  /// Цветная метка в списках: мастерская сама решает, что значит каждый цвет
  /// («щедрый», «спорит из-за каждой копейки»). Пусто — без метки.
  color           String?
  /// Аутсорс: партнёр, который сдаёт технику на ремонт (не частный клиент).
  /// Отметка в анкете; в заказах — фильтр «все аутсорс» или конкретный.
  isOutsource     Boolean      @default(false)
  note            String?
  consentAt       DateTime? // согласие на обработку персональных данных
  createdById     String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  deletedAt       DateTime?

  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  createdBy    User?         @relation(fields: [createdById], references: [id])
  devices      Device[]
  orders       Order[]
  transactions Transaction[]

  @@unique([tenantId, number])
  @@index([tenantId, phone])
  @@index([tenantId, name])
  @@index([tenantId, isOutsource])
}

/// Экземпляр техники клиента — чтобы видеть историю ремонтов одного аппарата.
model Device {
  id         String   @id @default(uuid())
  tenantId   String
  customerId String
  kind       String // ноутбук, ПК, монитор, принтер...
  brand      String?
  model      String?
  serial     String?
  note       String?
  createdAt  DateTime @default(now())

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  customer Customer @relation(fields: [customerId], references: [id])
  orders   Order[]

  @@index([tenantId, serial])
  @@index([tenantId, customerId])
}

/// Системная группа статуса не меняется — по ней считаются отчёты и SLA.
/// Название и цвет владелец может менять как угодно.
enum StatusGroup {
  NEW
  IN_PROGRESS
  WAITING
  DONE
  CLOSED
  CANCELLED
}

model OrderStatus {
  id        String      @id @default(uuid())
  tenantId  String
  name      String
  group     StatusGroup
  color     String      @default("#3559F5")
  sortOrder Int         @default(0)
  isInitial Boolean     @default(false)

  tenant  Tenant               @relation(fields: [tenantId], references: [id])
  orders  Order[]
  fromLog OrderStatusHistory[] @relation("StatusFrom")
  toLog   OrderStatusHistory[] @relation("StatusTo")

  @@unique([tenantId, name])
  @@index([tenantId])
}

enum OrderKind {
  REPAIR
  DIAGNOSTICS
  WARRANTY // возврат по гарантии
  REPEAT // повторное обращение
}

model Order {
  id       String    @id @default(uuid())
  tenantId String
  branchId String
  number   String // Р-2026-00123
  kind     OrderKind @default(REPAIR)
  isUrgent Boolean   @default(false)

  customerId String
  deviceId   String?

  // --- приём (заполняет приёмщик) ---
  acceptedById   String
  acceptedAt     DateTime  @default(now())
  dueAt          DateTime?
  complaint      String // неисправность СО СЛОВ КЛИЕНТА, дословно
  receptionNote  String? // технические примечания приёмщика
  devicePasscode String? // пароль / PIN / графический ключ
  completeness   Json      @default("[]") // чек-лист комплектности
  appearance     Json      @default("[]") // чек-лист внешних дефектов
  appearanceNote String?
  hasOpenTraces  Boolean   @default(false) // следы вскрытия
  hasWaterDamage Boolean   @default(false)
  storageLocation String? // стеллаж / ячейка

  estimatedCost Decimal? @db.Decimal(12, 2)
  approvedLimit Decimal? @db.Decimal(12, 2) // клиент согласовал сумму до
  prepayment    Decimal  @default(0) @db.Decimal(12, 2)

  // --- работа (заполняет мастер) ---
  assignedMasterId String?
  diagnosis        String?
  masterComment    String? // для приёмщика и клиента
  internalComment  String? // только внутри мастерской
  recommendation   String?
  warrantyDays     Int?
  warrantyUntil    DateTime?

  // --- гарантия и повторы ---
  parentOrderId String? // ссылка на прошлый ремонт

  // --- движение и деньги ---
  statusId    String
  completedAt DateTime?
  issuedAt    DateTime?
  issuedById  String?

  /// Чем расплатились на выдаче. Пусто, пока заказ не выдан.
  paymentMethod PaymentMethod?
  /// Когда клиент обещал заплатить. Только для выдачи в долг.
  debtDueAt     DateTime?
  /// Возвраты в работу после выдачи: [{ at, byId, reason, issuedAt, total, works, parts }].
  /// Снимок на момент возврата — по нему печатается «Акт доплаты» (orders/reopen.ts).
  reopens       Json?

  totalWork  Decimal @default(0) @db.Decimal(12, 2)
  totalParts Decimal @default(0) @db.Decimal(12, 2)
  discount   Decimal @default(0) @db.Decimal(12, 2) // разовая скидка при выдаче, в рублях
  total      Decimal @default(0) @db.Decimal(12, 2)

  // Скидка клиента на работы, снятая с его карточки при приёме и здесь
  // застывшая: если клиенту потом поменяют процент, старые заказы не должны
  // пересчитываться задним числом — по ним уже выдана квитанция.
  workDiscountPercent Decimal @default(0) @db.Decimal(5, 2)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? // заказы никогда не удаляются физически

  tenant         Tenant      @relation(fields: [tenantId], references: [id])
  branch         Branch      @relation(fields: [branchId], references: [id])
  customer       Customer    @relation(fields: [customerId], references: [id])
  device         Device?     @relation(fields: [deviceId], references: [id])
  status         OrderStatus @relation(fields: [statusId], references: [id])
  acceptedBy     User        @relation("OrderAcceptedBy", fields: [acceptedById], references: [id])
  assignedMaster User?       @relation("OrderAssignedMaster", fields: [assignedMasterId], references: [id])
  issuedBy       User?       @relation("OrderIssuedBy", fields: [issuedById], references: [id])
  parentOrder    Order?      @relation("OrderWarranty", fields: [parentOrderId], references: [id])
  childOrders    Order[]     @relation("OrderWarranty")

  works            OrderWork[]
  parts            OrderPart[]
  messages         OrderMessage[]
  attachments      Attachment[]
  statusHistory    OrderStatusHistory[]
  purchaseRequests PurchaseRequest[]
  stockMovements   StockMovement[]
  transactions     Transaction[]

  @@unique([tenantId, number])
  @@index([tenantId, statusId])
  @@index([tenantId, assignedMasterId])
  @@index([tenantId, customerId])
  @@index([tenantId, acceptedAt])
}

/**
 * Прайс мастерской: что она делает и почём.
 *
 * Это справочник для подсказок, а не источник истины по деньгам. В заказ
 * попадает копия названия и цены (OrderWork), поэтому поднятие прайса не
 * переписывает суммы в старых ремонтах, а удаление услуги не стирает
 * выполненную работу.
 */
model Service {
  id       String  @id @default(uuid())
  tenantId String
  name     String
  price    Decimal @default(0) @db.Decimal(12, 2)
  note     String? // уточнение для приёмщика: что входит, что нет
  isPinned Boolean @default(false) // вынесена кнопкой в карточку заказа

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, name])
  @@index([tenantId])
}

/// Что мастерская уже вводила руками в полях техники.
///
/// Справочника марок и моделей на свете не существует: у каждой мастерской
/// свой поток техники, и завести его сверху нельзя — его можно только
/// накопить. Поэтому строка запоминается в момент приёма и в следующий раз
/// предлагается с первой буквы.
///
/// scope — к чему вариант относится: у модели это марка (чтобы IdeaPad не
/// подсказывался под ASUS), у марки он пустой. Отдельной таблицы для каждого
/// поля не делаем: полей два, а разница между ними — одна строка.
model DeviceHint {
  id       String @id @default(uuid())
  tenantId String
  field    String // brand | model
  scope    String @default("")
  value    String

  /// Сколько раз пригодилось — по нему список и выстраивается.
  uses       Int      @default(1)
  lastUsedAt DateTime @default(now())
  createdAt  DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, field, scope, value])
  @@index([tenantId, field])
}

/// Кнопки быстрого заполнения на бланке приёма: комплектность и внешнее
/// состояние. Список у каждой мастерской свой и правится ею самой — та, что
/// чинит телефоны, не листает «Блок питания» и «Диск (HDD/SSD)».
model QuickPick {
  id        String   @id @default(uuid())
  tenantId  String
  field     String // completeness | appearance | complaint
  label     String
  /// Сколько раз пригодилась при приёме: по этому числу кнопки и выстроены.
  uses      Int      @default(0)
  /// Порядок при равном счёте. У новой мастерской все по нулю, и кнопки
  /// стоят в порядке справочника, а не по алфавиту.
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, field, label])
  @@index([tenantId, field])
}

model OrderStatusHistory {
  id           String   @id @default(uuid())
  tenantId     String
  orderId      String
  fromStatusId String?
  toStatusId   String
  userId       String?
  comment      String?
  createdAt    DateTime @default(now())

  tenant     Tenant       @relation(fields: [tenantId], references: [id])
  order      Order        @relation(fields: [orderId], references: [id])
  fromStatus OrderStatus? @relation("StatusFrom", fields: [fromStatusId], references: [id])
  toStatus   OrderStatus  @relation("StatusTo", fields: [toStatusId], references: [id])
  user       User?        @relation(fields: [userId], references: [id])

  @@index([tenantId, orderId])
}

model OrderWork {
  id        String   @id @default(uuid())
  tenantId  String
  orderId   String
  name      String
  qty       Decimal  @default(1) @db.Decimal(12, 3)
  price     Decimal  @db.Decimal(12, 2)
  masterId  String?
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])
  order  Order  @relation(fields: [orderId], references: [id])
  master User?  @relation(fields: [masterId], references: [id])

  @@index([tenantId, orderId])
}

enum PartSource {
  STOCK // со склада мастерской
  PURCHASED // докуплена под заказ
  CUSTOMER // принесена клиентом
}

model OrderPart {
  id          String     @id @default(uuid())
  tenantId    String
  orderId     String
  name        String
  qty         Decimal    @default(1) @db.Decimal(12, 3)
  price       Decimal    @db.Decimal(12, 2) // цена для клиента
  cost        Decimal?   @db.Decimal(12, 2) // себестоимость, видна не всем
  source      PartSource @default(STOCK)
  stockItemId String?
  createdAt   DateTime   @default(now())

  tenant    Tenant     @relation(fields: [tenantId], references: [id])
  order     Order      @relation(fields: [orderId], references: [id])
  stockItem StockItem? @relation(fields: [stockItemId], references: [id])

  @@index([tenantId, orderId])
}

enum AttachmentKind {
  INTAKE // фото при приёме
  COMPLETION // фото после ремонта
  DOCUMENT
  OTHER
  MESSAGE // фото в истории ремонта — к сообщению мастера
}

model Attachment {
  id                String         @id @default(uuid())
  tenantId          String
  orderId           String?
  purchaseRequestId String?
  /// Сообщение в истории ремонта, к которому приложен снимок.
  messageId         String?
  kind              AttachmentKind @default(OTHER)
  objectKey         String // ключ в S3/MinIO: tenantId/orderId/uuid.jpg
  fileName          String
  mimeType          String
  sizeBytes         Int
  uploadedById      String?
  createdAt         DateTime       @default(now())

  tenant          Tenant           @relation(fields: [tenantId], references: [id])
  order           Order?           @relation(fields: [orderId], references: [id])
  purchaseRequest PurchaseRequest? @relation(fields: [purchaseRequestId], references: [id])
  message         OrderMessage?    @relation(fields: [messageId], references: [id])
  uploadedBy      User?            @relation(fields: [uploadedById], references: [id])

  @@index([tenantId, orderId])
  @@index([messageId])
}

/// История ремонта: сообщения мастеров в карточке заказа, как в чате.
/// Удалённое сообщение не стирается, а помечается: история — это журнал.
model OrderMessage {
  id        String    @id @default(uuid())
  tenantId  String
  orderId   String
  authorId  String?
  text      String    @default("")
  /// Запись самой программы, а не сотрудника: «Клиент согласился по SMS».
  system    Boolean   @default(false)
  createdAt DateTime  @default(now())
  deletedAt DateTime?

  tenant      Tenant       @relation(fields: [tenantId], references: [id])
  order       Order        @relation(fields: [orderId], references: [id])
  author      User?        @relation(fields: [authorId], references: [id])
  attachments Attachment[]

  @@index([tenantId, orderId, createdAt])
}

// ------------------------------------------------------------
//  Заявки на закупку
// ------------------------------------------------------------

enum PurchaseStatus {
  DRAFT
  PENDING // на согласовании
  APPROVED
  ORDERED // заказано у поставщика
  RECEIVED
  REJECTED
}

model PurchaseRequest {
  id              String         @id @default(uuid())
  tenantId        String
  number          String
  createdById     String
  orderId         String? // может быть не привязана к заказу
  status          PurchaseStatus @default(DRAFT)
  comment         String?
  approvedById    String?
  approvedAt      DateTime?
  rejectionReason String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  tenant      Tenant                @relation(fields: [tenantId], references: [id])
  createdBy   User                  @relation("PurchaseCreatedBy", fields: [createdById], references: [id])
  approvedBy  User?                 @relation("PurchaseApprovedBy", fields: [approvedById], references: [id])
  order       Order?                @relation(fields: [orderId], references: [id])
  items       PurchaseRequestItem[]
  attachments Attachment[]
  movements   StockMovement[]

  @@unique([tenantId, number])
  @@index([tenantId, status])
}

model PurchaseRequestItem {
  id            String   @id @default(uuid())
  tenantId      String
  requestId     String
  name          String
  qty           Decimal  @default(1) @db.Decimal(12, 3)
  unit          String   @default("шт")
  link          String? // ссылка на магазин
  expectedPrice Decimal? @db.Decimal(12, 2)
  receivedQty   Decimal  @default(0) @db.Decimal(12, 3)
  stockItemId   String?
  note          String?

  tenant    Tenant          @relation(fields: [tenantId], references: [id])
  request   PurchaseRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  stockItem StockItem?      @relation(fields: [stockItemId], references: [id])

  @@index([tenantId, requestId])
}

// ------------------------------------------------------------
//  Склад — минимальный каркас, дорабатываем отдельно
// ------------------------------------------------------------

model Warehouse {
  id        String  @id @default(uuid())
  tenantId  String
  branchId  String?
  name      String
  isDefault Boolean @default(false)

  tenant    Tenant          @relation(fields: [tenantId], references: [id])
  branch    Branch?         @relation(fields: [branchId], references: [id])
  balances  StockBalance[]
  movements StockMovement[]

  @@index([tenantId])
}

model StockItem {
  id       String  @id @default(uuid())
  tenantId String
  sku      String?
  name     String
  unit     String  @default("шт")
  category String?
  minQty   Decimal @default(0) @db.Decimal(12, 3)
  isActive Boolean @default(true)

  tenant        Tenant                @relation(fields: [tenantId], references: [id])
  balances      StockBalance[]
  movements     StockMovement[]
  orderParts    OrderPart[]
  purchaseItems PurchaseRequestItem[]

  @@index([tenantId, name])
}

model StockBalance {
  id          String  @id @default(uuid())
  tenantId    String
  warehouseId String
  stockItemId String
  qty         Decimal @default(0) @db.Decimal(12, 3)
  avgCost     Decimal @default(0) @db.Decimal(12, 2)

  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  warehouse Warehouse @relation(fields: [warehouseId], references: [id])
  stockItem StockItem @relation(fields: [stockItemId], references: [id])

  @@unique([warehouseId, stockItemId])
  @@index([tenantId])
}

enum MovementType {
  IN
  OUT
  TRANSFER
  WRITE_OFF
  RETURN
  INVENTORY
}

model StockMovement {
  id                String       @id @default(uuid())
  tenantId          String
  warehouseId       String
  stockItemId       String
  type              MovementType
  qty               Decimal      @db.Decimal(12, 3)
  price             Decimal?     @db.Decimal(12, 2)
  orderId           String?
  purchaseRequestId String?
  userId            String?
  comment           String?
  createdAt         DateTime     @default(now())

  tenant          Tenant           @relation(fields: [tenantId], references: [id])
  warehouse       Warehouse        @relation(fields: [warehouseId], references: [id])
  stockItem       StockItem        @relation(fields: [stockItemId], references: [id])
  order           Order?           @relation(fields: [orderId], references: [id])
  purchaseRequest PurchaseRequest? @relation(fields: [purchaseRequestId], references: [id])
  user            User?            @relation(fields: [userId], references: [id])

  @@index([tenantId, createdAt])
}

// ------------------------------------------------------------
//  Финансы — минимальный каркас
// ------------------------------------------------------------

model CashRegister {
  id       String  @id @default(uuid())
  tenantId String
  branchId String?
  name     String
  kind     String  @default("CASH") // CASH | BANK | ACQUIRING
  isActive Boolean @default(true)

  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  branch       Branch?       @relation(fields: [branchId], references: [id])
  transactions Transaction[]

  @@index([tenantId])
}

/// Чем расплатились при выдаче.
///
/// Долг здесь — такой же способ закрыть выдачу, как наличные: техника уехала,
/// деньги остались за клиентом. Отдельным признаком «должен» заказ не метим —
/// долг считается как итог минус проведённые платежи и потому не может
/// разойтись с кассой.
enum PaymentMethod {
  CASH
  CARD
  DEBT
}

enum TxDirection {
  IN
  OUT
}

model TransactionCategory {
  id        String      @id @default(uuid())
  tenantId  String
  name      String
  direction TxDirection

  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  transactions Transaction[]

  @@unique([tenantId, name])
}

model Transaction {
  id             String      @id @default(uuid())
  tenantId       String
  cashRegisterId String
  categoryId     String?
  direction      TxDirection
  amount         Decimal     @db.Decimal(12, 2)
  orderId        String?
  customerId     String?
  userId         String?
  comment        String?
  createdAt      DateTime    @default(now())
  deletedAt      DateTime?

  tenant       Tenant               @relation(fields: [tenantId], references: [id])
  cashRegister CashRegister         @relation(fields: [cashRegisterId], references: [id])
  category     TransactionCategory? @relation(fields: [categoryId], references: [id])
  order        Order?               @relation(fields: [orderId], references: [id])
  customer     Customer?            @relation(fields: [customerId], references: [id])
  user         User?                @relation(fields: [userId], references: [id])

  @@index([tenantId, createdAt])
}

// ------------------------------------------------------------
//  Служебное
// ------------------------------------------------------------

/// Кто что изменил. Записи не удаляются и не редактируются.
model AuditLog {
  id        String   @id @default(uuid())
  tenantId  String
  userId    String?
  entity    String
  entityId  String
  action    String // CREATE | UPDATE | DELETE | STATUS | LOGIN
  diff      Json?
  ip        String?
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User?  @relation(fields: [userId], references: [id])

  @@index([tenantId, entity, entityId])
  @@index([tenantId, createdAt])
}

model Notification {
  id        String    @id @default(uuid())
  tenantId  String
  userId    String
  type      String
  title     String
  body      String?
  payload   Json?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@index([tenantId, userId, readAt])
}

/// Подписка браузера на push. Одна строка — одно устройство одного человека.
/// tenantId и userId пустые у собственника платформы: он не принадлежит мастерской,
/// а оповещения о новых заявках получать должен. Политика RLS пропускает такие
/// строки только в режиме платформы, мастерским они не видны.
model PushSubscription {
  id             String    @id @default(uuid())
  tenantId       String?
  userId         String?
  platformUserId String?
  endpoint       String    @unique
  p256dh         String
  auth           String
  userAgent      String?
  failedAt       DateTime?
  createdAt      DateTime  @default(now())

  tenant       Tenant?       @relation(fields: [tenantId], references: [id])
  user         User?         @relation(fields: [userId], references: [id])
  platformUser PlatformUser? @relation(fields: [platformUserId], references: [id])

  @@index([tenantId, userId])
  @@index([platformUserId])
}

// ------------------------------------------------------------
//  Зарплата
// ------------------------------------------------------------
//
// Расчёт с сотрудниками за месяц: на начало — начислено — получено — итого.
// Процент мастера считается на лету из оплаченных заказов (salary/calc.ts);
// здесь хранится только то, что вводят руками, и снимки закрытых месяцев.
// С кассой не связано: касса в мастерской не про одни ремонты, а выплаты
// зарплаты — про людей.

enum SalaryEntryKind {
  /// Остаток на начало месяца — вводится один раз, в первом месяце учёта.
  OPENING
  /// Оклад, премия, штраф (штраф — с минусом).
  BONUS
}

/// Начисления руками: оклад, премия, штраф, начальный остаток.
model SalaryEntry {
  id          String          @id @default(uuid())
  tenantId    String
  userId      String
  /// Месяц «2026-09» — по часам мастерской.
  month       String
  kind        SalaryEntryKind @default(BONUS)
  amount      Decimal         @db.Decimal(12, 2)
  comment     String?
  createdById String?
  createdAt   DateTime        @default(now())

  tenant    Tenant @relation(fields: [tenantId], references: [id])
  user      User   @relation("SalaryEntryUser", fields: [userId], references: [id])
  createdBy User?  @relation("SalaryEntryAuthor", fields: [createdById], references: [id])

  @@index([tenantId, month])
}

/// Выплаты сотрудникам: кому, когда, сколько. Не касса.
model SalaryPayout {
  id          String    @id @default(uuid())
  tenantId    String
  userId      String
  amount      Decimal   @db.Decimal(12, 2)
  paidAt      DateTime
  /// Месяц выплаты «2026-09» — по часам мастерской; считается из paidAt при записи.
  month       String
  comment     String?
  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  tenant    Tenant @relation(fields: [tenantId], references: [id])
  user      User   @relation("SalaryPayoutUser", fields: [userId], references: [id])
  createdBy User?  @relation("SalaryPayoutAuthor", fields: [createdById], references: [id])

  @@index([tenantId, month])
}

/// Закрытый месяц: снимок ведомости. Поздние правки заказов его не трогают.
model SalaryMonth {
  id         String   @id @default(uuid())
  tenantId   String
  month      String
  closedAt   DateTime @default(now())
  closedById String?
  snapshot   Json

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, month])
}

/// Компьютер с программой FineCRM, через который мастерская печатает.
/// Программа сама сообщает, какие принтеры видит её Windows (modules/printing).
model PrintStation {
  id         String   @id @default(uuid())
  tenantId   String
  /// Постоянный номер программы на этом компьютере — не меняется при смене имени.
  deviceId   String
  name       String
  /// [{ name, displayName, isDefault }] — как их видит Windows.
  printers   Json     @default("[]")
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())

  tenant Tenant     @relation(fields: [tenantId], references: [id])
  jobs   PrintJob[]

  @@unique([tenantId, deviceId])
}

enum PrintJobStatus {
  QUEUED
  SENT
  DONE
  FAILED
}

/// Задание печати: кто-то нажал «Печать», компьютер с принтером забирает и печатает.
model PrintJob {
  id          String         @id @default(uuid())
  tenantId    String
  stationId   String
  printerName String
  /// intake — квитанция, act — акт работ, test — тестовая страница,
  /// label — наклейки на технику, label-test — пробная наклейка.
  doc         String
  /// Наклейки: { items: ["device", "Блок питания"] } — на что печатать.
  options     Json?
  /// Без связи с заказом: стирание заказов не должно спотыкаться о старые задания.
  orderId     String?
  copies      Int            @default(1)
  status      PrintJobStatus @default(QUEUED)
  error       String?
  createdById String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  tenant  Tenant       @relation(fields: [tenantId], references: [id])
  station PrintStation @relation(fields: [stationId], references: [id])

  @@index([stationId, status])
}

/// Подключённые внешние сервисы мастерской. Секрет (ключ API) живёт здесь, а
/// не в Tenant.settings: настройки уходят в интерфейс целиком, ключ — никогда.
model Integration {
  id        String   @id @default(uuid())
  tenantId  String
  /// semysms — SMS через телефон-шлюз SemySMS.
  kind      String
  enabled   Boolean  @default(false)
  secret    String?
  config    Json     @default("{}")
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, kind])
}

enum SmsStatus {
  /// Шлюз SemySMS принял, ждёт, пока телефон заберёт.
  QUEUED
  /// Телефон отправил.
  SENT
  /// Оператор подтвердил доставку.
  DELIVERED
  /// Не ушла: ошибка шлюза, телефона или отмена.
  FAILED
}

/// SMS клиенту. orderId без связи — как у заданий печати: стирание заказов
/// не должно спотыкаться о старые сообщения.
model SmsMessage {
  id          String    @id @default(uuid())
  tenantId    String
  orderId     String?
  customerId  String?
  phone       String
  text        String
  /// ready — «Готов к выдаче», free — своим текстом, test — проверка из настроек.
  kind        String
  status      SmsStatus @default(QUEUED)
  providerId  String?
  error       String?
  createdById String?
  checkedAt   DateTime?
  /// Отправка своим телефоном: какой телефон забрал и когда.
  phoneId     String?
  pickedAt    DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, orderId])
  @@index([tenantId, status])
}

/// Согласование по SMS: вопрос клиенту и его ответ.
///
/// Ответ приходит на телефон-шлюз. Телефон пересылает только SMS с номеров,
/// от которых ждут ответа (список ему даёт сервер), — личные сообщения
/// с телефона никуда не уходят.
model SmsApproval {
  id        String    @id @default(uuid())
  tenantId  String
  orderId   String
  /// Вопрос — обычная SMS в истории отправленных.
  smsId     String?
  /// Номер клиента как его отправляли: +79211234567.
  phone     String
  /// PENDING — ждём ответа, YES / NO — ответил, UNCLEAR — ответ непонятен,
  /// CANCELLED — спросили заново или отменили, EXPIRED — не ответил за 3 дня.
  status    String    @default("PENDING")
  replyText String?
  repliedAt DateTime?
  /// Кто решил за клиента: непонятный ответ или клиент ответил по телефону.
  decidedById String?
  createdById String?
  createdAt DateTime  @default(now())
  expiresAt DateTime

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, orderId])
  @@index([tenantId, phone, status])
}

/// Свой телефон-шлюз: приложение «FineCRM SMS» на Android. Подключается по
/// одноразовому коду (pairCode живёт 10 минут), дальше ходит с ключом:
/// «<id>.<секрет>», в базе — только отпечаток секрета.
model SmsPhone {
  id            String    @id @default(uuid())
  tenantId      String
  name          String    @default("Телефон")
  pairCode      String?   @unique
  pairExpiresAt DateTime?
  tokenHash     String?
  /// Батарея, зарядка, SIM-карты, версия приложения — что телефон сообщил о себе.
  info          Json      @default("{}")
  lastSeenAt    DateTime?
  revokedAt     DateTime?
  createdAt     DateTime  @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])
}

