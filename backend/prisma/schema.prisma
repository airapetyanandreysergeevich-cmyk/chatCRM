// RepairShop — облачная CRM для мастерских по ремонту техники.
// Многоарендность: одна база, tenantId в каждой таблице арендатора + RLS в PostgreSQL.
// Черновик v0.1 — обсуждаем и правим до первой миграции.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
//  ПЛАТФОРМА — вне арендаторов, RLS не применяется
// ============================================================

enum PlatformRole {
  OWNER // собственник: все права, включая управление администраторами и тарифами
  ADMIN // администратор: всё, кроме создания администраторов и биллинга
}

enum TenantStatus {
  ACTIVE
  READONLY // подписка не оплачена: данные видны, изменения запрещены
  SUSPENDED
}

model PlatformUser {
  id           String       @id @default(uuid())
  email        String       @unique
  passwordHash String
  fullName     String
  role         PlatformRole @default(ADMIN)
  isActive     Boolean      @default(true)
  totpSecret   String?
  lastLoginAt  DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  impersonations Impersonation[]
  auditLogs      PlatformAuditLog[]
  sessions       Session[]
  reviewedApplications TenantApplication[]
}

model Tenant {
  id       String       @id @default(uuid())
  name     String
  slug     String       @unique // короткий код мастерской, часть логина сотрудника
  status   TenantStatus @default(ACTIVE)
  plan     String       @default("trial")
  timezone String       @default("Europe/Moscow")

  maxUsers    Int    @default(10)
  maxStorageMb Int   @default(5000)

  // нумерация заказов — своя у каждой мастерской
  orderNumberPrefix String @default("Р")
  orderNumberNext   Int    @default(1)

  contactName  String?
  contactPhone String?
  contactEmail String?
  settings     Json    @default("{}")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  branches            Branch[]
  roles               Role[]
  users               User[]
  customers           Customer[]
  devices             Device[]
  orderStatuses       OrderStatus[]
  orders              Order[]
  orderStatusHistory  OrderStatusHistory[]
  orderWorks          OrderWork[]
  orderParts          OrderPart[]
  attachments         Attachment[]
  purchaseRequests    PurchaseRequest[]
  purchaseItems       PurchaseRequestItem[]
  warehouses          Warehouse[]
  stockItems          StockItem[]
  stockBalances       StockBalance[]
  stockMovements      StockMovement[]
  cashRegisters       CashRegister[]
  txCategories        TransactionCategory[]
  transactions        Transaction[]
  auditLogs           AuditLog[]
  notifications       Notification[]
  pushSubscriptions   PushSubscription[]
  impersonations      Impersonation[]
  sessions            Session[]
  application         TenantApplication[]
}

/// Вход собственника или администратора платформы в базу арендатора.
/// Пишется всегда, виден владельцу мастерской в его кабинете.
model Impersonation {
  id             String    @id @default(uuid())
  platformUserId String
  tenantId       String
  reason         String?
  ip             String?
  startedAt      DateTime  @default(now())
  endedAt        DateTime?

  platformUser PlatformUser @relation(fields: [platformUserId], references: [id])
  tenant       Tenant       @relation(fields: [tenantId], references: [id])

  @@index([tenantId, startedAt])
}

model PlatformAuditLog {
  id             String   @id @default(uuid())
  platformUserId String?
  tenantId       String?
  action         String
  meta           Json?
  ip             String?
  createdAt      DateTime @default(now())

  platformUser PlatformUser? @relation(fields: [platformUserId], references: [id])

  @@index([createdAt])
}

/// Refresh-сессии и для сотрудников арендаторов, и для платформенных пользователей.
model Session {
  id             String    @id @default(uuid())
  tenantId       String?
  userId         String?
  platformUserId String?
  refreshHash    String    @unique
  expiresAt      DateTime
  revokedAt      DateTime?
  ip             String?
  userAgent      String?
  createdAt      DateTime  @default(now())

  tenant       Tenant?       @relation(fields: [tenantId], references: [id])
  user         User?         @relation(fields: [userId], references: [id])
  platformUser PlatformUser? @relation(fields: [platformUserId], references: [id])

  @@index([userId])
  @@index([platformUserId])
}

enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

/// Заявка на подключение мастерской.
/// Пока она не одобрена, мастерской не существует: ни базы, ни ролей, ни статусов.
/// Отклонённая заявка не оставляет за собой ничего, кроме этой строки.
model TenantApplication {
  id            String            @id @default(uuid())
  workshopName  String
  ownerFullName String
  ownerEmail    String
  ownerPhone    String
  /// Пароль задаёт сам заявитель ещё до одобрения — храним только хеш.
  passwordHash  String
  city          String?
  comment       String?
  status        ApplicationStatus @default(PENDING)

  ip        String?
  userAgent String?

  reviewedById    String?
  reviewedAt      DateTime?
  rejectionReason String?
  /// Мастерская, созданная по этой заявке.
  tenantId        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reviewedBy PlatformUser? @relation(fields: [reviewedById], references: [id])
  tenant     Tenant?       @relation(fields: [tenantId], references: [id])

  @@index([status, createdAt])
  @@index([ownerEmail])
}

// ============================================================
//  АРЕНДАТОР — всё ниже под RLS по tenantId
// ============================================================

model Branch {
  id        String   @id @default(uuid())
  tenantId  String
  name      String
  address   String?
  phone     String?
  isDefault Boolean  @default(false)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  tenant        Tenant         @relation(fields: [tenantId], references: [id])
  users         User[]
  orders        Order[]
  warehouses    Warehouse[]
  cashRegisters CashRegister[]

  @@index([tenantId])
}

/// Роль = именованный набор прав. Пять системных пресетов создаются вместе с мастерской,
/// владелец может склонировать пресет и подправить набор под себя.
model Role {
  id          String   @id @default(uuid())
  tenantId    String
  name        String
  code        String? // MANAGER | RECEPTIONIST | MASTER | ACCOUNTANT | COURIER — у системных
  isSystem    Boolean  @default(false)
  permissions String[]
  createdAt   DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])
  users  User[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

model User {
  id       String @id @default(uuid())
  tenantId String

  /// Вход единый для всех, поэтому email уникален по всей платформе, а не внутри мастерской.
  /// Если у сотрудника нет почты, владелец заводит адрес вида master1@proba.local —
  /// он служит только идентификатором для входа.
  email        String @unique
  passwordHash String
  fullName     String
  phone        String?
  roleId       String?
  branchId     String?
  isOwner      Boolean @default(false) // владелец мастерской: все права, не удаляется
  isActive     Boolean @default(true)

  // для мастеров — расчёт зарплаты
  workPercent Decimal? @db.Decimal(5, 2)
  partPercent Decimal? @db.Decimal(5, 2)
  salaryBase  Decimal? @db.Decimal(12, 2)

  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  tenant Tenant  @relation(fields: [tenantId], references: [id])
  role   Role?   @relation(fields: [roleId], references: [id])
  branch Branch? @relation(fields: [branchId], references: [id])

  sessions          Session[]
  acceptedOrders    Order[]              @relation("OrderAcceptedBy")
  assignedOrders    Order[]              @relation("OrderAssignedMaster")
  issuedOrders      Order[]              @relation("OrderIssuedBy")
  createdCustomers  Customer[]
  statusChanges     OrderStatusHistory[]
  works             OrderWork[]
  attachments       Attachment[]
  purchaseCreated   PurchaseRequest[]    @relation("PurchaseCreatedBy")
  purchaseApproved  PurchaseRequest[]    @relation("PurchaseApprovedBy")
  stockMovements    StockMovement[]
  transactions      Transaction[]
  auditLogs         AuditLog[]
  notifications     Notification[]
  pushSubscriptions PushSubscription[]

  @@index([tenantId])
}

enum CustomerType {
  INDIVIDUAL
  COMPANY
}

model Customer {
  id              String       @id @default(uuid())
  tenantId        String
  type            CustomerType @default(INDIVIDUAL)
  name            String
  phone           String
  phone2          String?
  email           String?
  address         String?
  source          String? // источник обращения
  inn             String? // для юрлиц
  discountPercent Decimal      @default(0) @db.Decimal(5, 2)
  note            String?
  consentAt       DateTime? // согласие на обработку персональных данных
  createdById     String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  deletedAt       DateTime?

  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  createdBy    User?         @relation(fields: [createdById], references: [id])
  devices      Device[]
  orders       Order[]
  transactions Transaction[]

  @@index([tenantId, phone])
  @@index([tenantId, name])
}

/// Экземпляр техники клиента — чтобы видеть историю ремонтов одного аппарата.
model Device {
  id         String   @id @default(uuid())
  tenantId   String
  customerId String
  kind       String // ноутбук, ПК, монитор, принтер...
  brand      String?
  model      String?
  serial     String?
  note       String?
  createdAt  DateTime @default(now())

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  customer Customer @relation(fields: [customerId], references: [id])
  orders   Order[]

  @@index([tenantId, serial])
  @@index([tenantId, customerId])
}

/// Системная группа статуса не меняется — по ней считаются отчёты и SLA.
/// Название и цвет владелец может менять как угодно.
enum StatusGroup {
  NEW
  IN_PROGRESS
  WAITING
  DONE
  CLOSED
  CANCELLED
}

model OrderStatus {
  id        String      @id @default(uuid())
  tenantId  String
  name      String
  group     StatusGroup
  color     String      @default("#3559F5")
  sortOrder Int         @default(0)
  isInitial Boolean     @default(false)

  tenant  Tenant               @relation(fields: [tenantId], references: [id])
  orders  Order[]
  fromLog OrderStatusHistory[] @relation("StatusFrom")
  toLog   OrderStatusHistory[] @relation("StatusTo")

  @@unique([tenantId, name])
  @@index([tenantId])
}

enum OrderKind {
  REPAIR
  DIAGNOSTICS
  WARRANTY // возврат по гарантии
  REPEAT // повторное обращение
}

model Order {
  id       String    @id @default(uuid())
  tenantId String
  branchId String
  number   String // Р-2026-00123
  kind     OrderKind @default(REPAIR)
  isUrgent Boolean   @default(false)

  customerId String
  deviceId   String?

  // --- приём (заполняет приёмщик) ---
  acceptedById   String
  acceptedAt     DateTime  @default(now())
  dueAt          DateTime?
  complaint      String // неисправность СО СЛОВ КЛИЕНТА, дословно
  receptionNote  String? // технические примечания приёмщика
  devicePasscode String? // пароль / PIN / графический ключ
  completeness   Json      @default("[]") // чек-лист комплектности
  appearance     Json      @default("[]") // чек-лист внешних дефектов
  appearanceNote String?
  hasOpenTraces  Boolean   @default(false) // следы вскрытия
  hasWaterDamage Boolean   @default(false)
  storageLocation String? // стеллаж / ячейка

  estimatedCost Decimal? @db.Decimal(12, 2)
  approvedLimit Decimal? @db.Decimal(12, 2) // клиент согласовал сумму до
  prepayment    Decimal  @default(0) @db.Decimal(12, 2)

  // --- работа (заполняет мастер) ---
  assignedMasterId String?
  diagnosis        String?
  masterComment    String? // для приёмщика и клиента
  internalComment  String? // только внутри мастерской
  recommendation   String?
  warrantyDays     Int?
  warrantyUntil    DateTime?

  // --- гарантия и повторы ---
  parentOrderId String? // ссылка на прошлый ремонт

  // --- движение и деньги ---
  statusId    String
  completedAt DateTime?
  issuedAt    DateTime?
  issuedById  String?

  totalWork  Decimal @default(0) @db.Decimal(12, 2)
  totalParts Decimal @default(0) @db.Decimal(12, 2)
  discount   Decimal @default(0) @db.Decimal(12, 2)
  total      Decimal @default(0) @db.Decimal(12, 2)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? // заказы никогда не удаляются физически

  tenant         Tenant      @relation(fields: [tenantId], references: [id])
  branch         Branch      @relation(fields: [branchId], references: [id])
  customer       Customer    @relation(fields: [customerId], references: [id])
  device         Device?     @relation(fields: [deviceId], references: [id])
  status         OrderStatus @relation(fields: [statusId], references: [id])
  acceptedBy     User        @relation("OrderAcceptedBy", fields: [acceptedById], references: [id])
  assignedMaster User?       @relation("OrderAssignedMaster", fields: [assignedMasterId], references: [id])
  issuedBy       User?       @relation("OrderIssuedBy", fields: [issuedById], references: [id])
  parentOrder    Order?      @relation("OrderWarranty", fields: [parentOrderId], references: [id])
  childOrders    Order[]     @relation("OrderWarranty")

  works            OrderWork[]
  parts            OrderPart[]
  attachments      Attachment[]
  statusHistory    OrderStatusHistory[]
  purchaseRequests PurchaseRequest[]
  stockMovements   StockMovement[]
  transactions     Transaction[]

  @@unique([tenantId, number])
  @@index([tenantId, statusId])
  @@index([tenantId, assignedMasterId])
  @@index([tenantId, customerId])
  @@index([tenantId, acceptedAt])
}

model OrderStatusHistory {
  id           String   @id @default(uuid())
  tenantId     String
  orderId      String
  fromStatusId String?
  toStatusId   String
  userId       String?
  comment      String?
  createdAt    DateTime @default(now())

  tenant     Tenant       @relation(fields: [tenantId], references: [id])
  order      Order        @relation(fields: [orderId], references: [id])
  fromStatus OrderStatus? @relation("StatusFrom", fields: [fromStatusId], references: [id])
  toStatus   OrderStatus  @relation("StatusTo", fields: [toStatusId], references: [id])
  user       User?        @relation(fields: [userId], references: [id])

  @@index([tenantId, orderId])
}

model OrderWork {
  id        String   @id @default(uuid())
  tenantId  String
  orderId   String
  name      String
  qty       Decimal  @default(1) @db.Decimal(12, 3)
  price     Decimal  @db.Decimal(12, 2)
  masterId  String?
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])
  order  Order  @relation(fields: [orderId], references: [id])
  master User?  @relation(fields: [masterId], references: [id])

  @@index([tenantId, orderId])
}

enum PartSource {
  STOCK // со склада мастерской
  PURCHASED // докуплена под заказ
  CUSTOMER // принесена клиентом
}

model OrderPart {
  id          String     @id @default(uuid())
  tenantId    String
  orderId     String
  name        String
  qty         Decimal    @default(1) @db.Decimal(12, 3)
  price       Decimal    @db.Decimal(12, 2) // цена для клиента
  cost        Decimal?   @db.Decimal(12, 2) // себестоимость, видна не всем
  source      PartSource @default(STOCK)
  stockItemId String?
  createdAt   DateTime   @default(now())

  tenant    Tenant     @relation(fields: [tenantId], references: [id])
  order     Order      @relation(fields: [orderId], references: [id])
  stockItem StockItem? @relation(fields: [stockItemId], references: [id])

  @@index([tenantId, orderId])
}

enum AttachmentKind {
  INTAKE // фото при приёме
  COMPLETION // фото после ремонта
  DOCUMENT
  OTHER
}

model Attachment {
  id                String         @id @default(uuid())
  tenantId          String
  orderId           String?
  purchaseRequestId String?
  kind              AttachmentKind @default(OTHER)
  objectKey         String // ключ в S3/MinIO: tenantId/orderId/uuid.jpg
  fileName          String
  mimeType          String
  sizeBytes         Int
  uploadedById      String?
  createdAt         DateTime       @default(now())

  tenant          Tenant           @relation(fields: [tenantId], references: [id])
  order           Order?           @relation(fields: [orderId], references: [id])
  purchaseRequest PurchaseRequest? @relation(fields: [purchaseRequestId], references: [id])
  uploadedBy      User?            @relation(fields: [uploadedById], references: [id])

  @@index([tenantId, orderId])
}

// ------------------------------------------------------------
//  Заявки на закупку
// ------------------------------------------------------------

enum PurchaseStatus {
  DRAFT
  PENDING // на согласовании
  APPROVED
  ORDERED // заказано у поставщика
  RECEIVED
  REJECTED
}

model PurchaseRequest {
  id              String         @id @default(uuid())
  tenantId        String
  number          String
  createdById     String
  orderId         String? // может быть не привязана к заказу
  status          PurchaseStatus @default(DRAFT)
  comment         String?
  approvedById    String?
  approvedAt      DateTime?
  rejectionReason String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  tenant      Tenant                @relation(fields: [tenantId], references: [id])
  createdBy   User                  @relation("PurchaseCreatedBy", fields: [createdById], references: [id])
  approvedBy  User?                 @relation("PurchaseApprovedBy", fields: [approvedById], references: [id])
  order       Order?                @relation(fields: [orderId], references: [id])
  items       PurchaseRequestItem[]
  attachments Attachment[]
  movements   StockMovement[]

  @@unique([tenantId, number])
  @@index([tenantId, status])
}

model PurchaseRequestItem {
  id            String   @id @default(uuid())
  tenantId      String
  requestId     String
  name          String
  qty           Decimal  @default(1) @db.Decimal(12, 3)
  unit          String   @default("шт")
  link          String? // ссылка на магазин
  expectedPrice Decimal? @db.Decimal(12, 2)
  receivedQty   Decimal  @default(0) @db.Decimal(12, 3)
  stockItemId   String?
  note          String?

  tenant    Tenant          @relation(fields: [tenantId], references: [id])
  request   PurchaseRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  stockItem StockItem?      @relation(fields: [stockItemId], references: [id])

  @@index([tenantId, requestId])
}

// ------------------------------------------------------------
//  Склад — минимальный каркас, дорабатываем отдельно
// ------------------------------------------------------------

model Warehouse {
  id        String  @id @default(uuid())
  tenantId  String
  branchId  String?
  name      String
  isDefault Boolean @default(false)

  tenant    Tenant          @relation(fields: [tenantId], references: [id])
  branch    Branch?         @relation(fields: [branchId], references: [id])
  balances  StockBalance[]
  movements StockMovement[]

  @@index([tenantId])
}

model StockItem {
  id       String  @id @default(uuid())
  tenantId String
  sku      String?
  name     String
  unit     String  @default("шт")
  category String?
  minQty   Decimal @default(0) @db.Decimal(12, 3)
  isActive Boolean @default(true)

  tenant        Tenant                @relation(fields: [tenantId], references: [id])
  balances      StockBalance[]
  movements     StockMovement[]
  orderParts    OrderPart[]
  purchaseItems PurchaseRequestItem[]

  @@index([tenantId, name])
}

model StockBalance {
  id          String  @id @default(uuid())
  tenantId    String
  warehouseId String
  stockItemId String
  qty         Decimal @default(0) @db.Decimal(12, 3)
  avgCost     Decimal @default(0) @db.Decimal(12, 2)

  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  warehouse Warehouse @relation(fields: [warehouseId], references: [id])
  stockItem StockItem @relation(fields: [stockItemId], references: [id])

  @@unique([warehouseId, stockItemId])
  @@index([tenantId])
}

enum MovementType {
  IN
  OUT
  TRANSFER
  WRITE_OFF
  RETURN
  INVENTORY
}

model StockMovement {
  id                String       @id @default(uuid())
  tenantId          String
  warehouseId       String
  stockItemId       String
  type              MovementType
  qty               Decimal      @db.Decimal(12, 3)
  price             Decimal?     @db.Decimal(12, 2)
  orderId           String?
  purchaseRequestId String?
  userId            String?
  comment           String?
  createdAt         DateTime     @default(now())

  tenant          Tenant           @relation(fields: [tenantId], references: [id])
  warehouse       Warehouse        @relation(fields: [warehouseId], references: [id])
  stockItem       StockItem        @relation(fields: [stockItemId], references: [id])
  order           Order?           @relation(fields: [orderId], references: [id])
  purchaseRequest PurchaseRequest? @relation(fields: [purchaseRequestId], references: [id])
  user            User?            @relation(fields: [userId], references: [id])

  @@index([tenantId, createdAt])
}

// ------------------------------------------------------------
//  Финансы — минимальный каркас
// ------------------------------------------------------------

model CashRegister {
  id       String  @id @default(uuid())
  tenantId String
  branchId String?
  name     String
  kind     String  @default("CASH") // CASH | BANK | ACQUIRING
  isActive Boolean @default(true)

  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  branch       Branch?       @relation(fields: [branchId], references: [id])
  transactions Transaction[]

  @@index([tenantId])
}

enum TxDirection {
  IN
  OUT
}

model TransactionCategory {
  id        String      @id @default(uuid())
  tenantId  String
  name      String
  direction TxDirection

  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  transactions Transaction[]

  @@unique([tenantId, name])
}

model Transaction {
  id             String      @id @default(uuid())
  tenantId       String
  cashRegisterId String
  categoryId     String?
  direction      TxDirection
  amount         Decimal     @db.Decimal(12, 2)
  orderId        String?
  customerId     String?
  userId         String?
  comment        String?
  createdAt      DateTime    @default(now())
  deletedAt      DateTime?

  tenant       Tenant               @relation(fields: [tenantId], references: [id])
  cashRegister CashRegister         @relation(fields: [cashRegisterId], references: [id])
  category     TransactionCategory? @relation(fields: [categoryId], references: [id])
  order        Order?               @relation(fields: [orderId], references: [id])
  customer     Customer?            @relation(fields: [customerId], references: [id])
  user         User?                @relation(fields: [userId], references: [id])

  @@index([tenantId, createdAt])
}

// ------------------------------------------------------------
//  Служебное
// ------------------------------------------------------------

/// Кто что изменил. Записи не удаляются и не редактируются.
model AuditLog {
  id        String   @id @default(uuid())
  tenantId  String
  userId    String?
  entity    String
  entityId  String
  action    String // CREATE | UPDATE | DELETE | STATUS | LOGIN
  diff      Json?
  ip        String?
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User?  @relation(fields: [userId], references: [id])

  @@index([tenantId, entity, entityId])
  @@index([tenantId, createdAt])
}

model Notification {
  id        String    @id @default(uuid())
  tenantId  String
  userId    String
  type      String
  title     String
  body      String?
  payload   Json?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@index([tenantId, userId, readAt])
}

model PushSubscription {
  id        String   @id @default(uuid())
  tenantId  String
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@index([tenantId, userId])
}
